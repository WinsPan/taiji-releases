{
  "description": "taiji：工具调用前风险评估；工具返回扫描写给 AI 的指令；记录用户要求。",
  "hooks": {
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "sh \"${PLUGIN_ROOT}/plugin/bin/taiji-hook.sh\" --agent codex", "timeout": 25, "statusMessage": "taiji：评估工具调用" } ] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "sh \"${PLUGIN_ROOT}/plugin/bin/taiji-hook.sh\" --agent codex", "timeout": 25, "statusMessage": "taiji：扫描工具返回" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${PLUGIN_ROOT}/plugin/bin/taiji-hook.sh\" --agent codex", "timeout": 5, "statusMessage": "taiji：记录要求" } ] }
    ]
  }
}
